#!/usr/bin/bash

 NC='\e[0m'; RED='\e[1;31m';GREEN='\e[0;32m';green='\e[1;32m';YELLOW='\e[0;33m';yellow='\e[1;33m'; 
# 

helpme="
$BAT -p -f -l markdown << 'EOF'
folder: $folder
promp: $prompt



# TODO

ctrl+b	            $BAT 
ctrl+w              preview in browser
ctrl+p              pdf
ctrl+g              groffdown
ctrl+p	    :   bcat 
ctrl+alt+p  :   groffdown 



# FZZ VARIABLES

## Just the current line \{\}
{}

## Just the current line - field1 \{1\}
{1}

## Just the current line - field2 \{2\}
{2}

## All selected line \{+\}
{+}

## The path to the tmp file (current line) \{f\}
{f}

## The path to the tmp file (all selected line) \{+f\}  
{+f}

## The Query \{q\}
{q}
EOF
"

previeww3mtest="
echo -e '${GREEN}{1}\\\n';
echo -e '${yellow}FROM: {6}';
echo DURATION: {3};
echo SIZE: {4}\\\n;
echo -e \"${NC}URL: {2}\\\n\";
w3m -dump -T text/html << 'EOF' | $BAT -p -f -l markdown
{5}
EOF
"
# Work second good option
previeww3m="
w3m -dump -T text/html << EOF | $BAT -p -f  -l markdown
<h1>{1}</h1>

<h2>{3}</h2>

{5}
EOF
"

# marche mais trop de parsing, difficile à ecrire 
previewtest="echo {1}\\\n\\\n\\\nFROM: {6}\\\n\\\nDURATION: {3};echo SIZE: {4}\\\nURL: {2}\\\n\\\n; echo {5} | w3m -dump -T text/html | $BAT -p -f  -l markdown"

previewPandoc="
/usr/bin/pandoc -f html -t plain  << EOF | $BAT -p -f  -l markdown
<h1>{1}</h1>

<h2>{3}</h2>

{5}
EOF
"


/usr/bin/wget -q https://linuxmatters.sh/episode/index.xml -O - | /usr/bin/xsltproc /home/fred/.repo/podbash/parse_enclosure.xsl - >tmp.tsv

#/usr/bin/wget -q https://feeds.audiomeans.fr/feed/01a5bd92-d6c8-4572-8092-88e4c9953cc9.xml -O - | /usr/bin/xsltproc /home/fred/.repo/podbash/itune2m3u.xsl - >tmp.m3u

# hullcaster
#sqlite3 --tabs ~/.config/hullcaster/data.db "SELECT title,url,duration,duration,replace(description,CHAR(10),'') FROM episodes WHERE played=false" >tmp.tsv

# newsboat
#sqlite3 --tabs ~/.newsboat/podcast.db "SELECT * FROM podbash2" >tmp.tsv
sqlite3 --tabs ~/.newsboat/podcast.db  < ~/.newsboat/podbash.sql >tmp.tsv








 fzf --delimiter='\t' --with-nth 1,3,4 --ansi --prompt='Run: '   --multi  --layout=reverse  --info=right  --header-lines=1  --preview-window right:40%  \
 --preview "$previewtest" \
 --bind "ctrl-t:preview%($previewPandoc)%" \
 --bind "ctrl-w:preview%($previeww3m)%" \
 \
 --bind "ctrl-h:preview%($helpme)%" \
 --bind 'ctrl-v:toggle-preview' \
 --bind "enter:execute(mpv --no-video \$(awk -F '\t' '{print \$2}' {+f} ) < /dev/tty > /dev/tty 2>&1)" \
 --bind "ctrl-p:execute(mpc --host pi  add \$(awk -F '\t' '{print \$2}' {+f} ) < /dev/tty > /dev/tty 2>&1)"\
  --header "(a)ll (p)i (h)elp (h)help cod(e)" <   <(column -s "$(printf '\t')" -t -o "$(printf '\t')" -C name=TITLE -C name=URL -C name=INFO2 -C name=INFO2 -C name=DES tmp.tsv)

 # < tmp.tsv

 #  cat tmp.tsv |column -c 80 -s "$(printf '\t')" -t -N "TITLE,URL,INFO1,INFO2,DESCRIPTION" -E "DESCRIPTION" -T "TITLE" -o "|"

